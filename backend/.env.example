# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://causetrace:causetrace_dev@localhost:5433/causetrace
GROQ_API_KEY=
# Groq free tier = 8k tokens/min PER MODEL, so work is split across two models:
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_ALT=openai/gpt-oss-20b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# true = canned responses, no Groq calls (plumbing/UI testing only)
MOCK_LLM=true
CORS_ORIGINS=http://localhost:5173
